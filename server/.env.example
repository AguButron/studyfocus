# Copia este archivo como .env. Sin DATABASE_URL no hay cuentas, y sin cuenta no se puede entrar a una sala.

# Dirección de la base de datos PostgreSQL. En Neon, la que tiene -pooler, con sslmode=verify-full.
DATABASE_URL=

# ID de cliente de Google. Sin él, solo funcionan las cuentas locales.
GOOGLE_CLIENT_ID=

# Clave de la API de Gemini (Google AI Studio) para leer los programas de los cursos. Sin ella, esa opción avisa que no está configurada.
GEMINI_API_KEY=

# Opcional: el modelo de Gemini. Si no se pone, se usa gemini-3.5-flash, y si está saturado, otros más livianos.
GEMINI_MODEL=

# Opcional: cuántos programas puede leer cada persona cada 24 horas (por defecto 10). 0 es sin límite: solo para pruebas.
SYLLABUS_DAILY_LIMIT=
